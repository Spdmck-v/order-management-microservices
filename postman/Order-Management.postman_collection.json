              "raw": "{{baseUrl}}/api/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "orders"
              ]
            },
            "description": "Envía un X-Trace-Id fijo a través del Gateway y verifica que la respuesta lo devuelve intacto (propagación end-to-end)."
          },
          "response": []
        }
      ]
    }
