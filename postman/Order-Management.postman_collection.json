        {
          "name": "Crear pedido con X-Trace-Id fijo",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"X-Trace-Id de la respuesta igual al enviado\", function () {",
                  "   pm.expect(pm.response.headers.get('X-Trace-Id')).to.eql('traceid-fixed-0000000000000001');",
                  "});",
                  "var body = pm.response.json();",
                  "if (body.id) {",
                  "    pm.environment.set(\"orderId\", body.id);",
                  "}",
                  ""
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "X-Trace-Id",
                "value": "traceid-fixed-0000000000000001"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"productId\": \"{{productId}}\",\n      \"quantity\": 1\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
