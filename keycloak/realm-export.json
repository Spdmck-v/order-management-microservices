{
  "realm": "orders-realm",
  "enabled": true,
  "roles": {
    "realm": [
      {
        "name": "user",
        "description": "Standard user role"
      },
      {
        "name": "admin",
        "description": "Administrator role"
      }
    ]
  },
  "clients": [
    {
      "clientId": "postman-client",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": false,
      "redirectUris": ["*"]
    },
    {
      "clientId": "api-gateway",
      "enabled": true,
      "bearerOnly": true,
      "publicClient": false,
      "redirectUris": []
    }
  ],
  "users": [
    {
      "username": "testuser",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Test",
      "lastName": "User",
      "email": "testuser@example.com",
      "credentials": [
        {
          "type": "password",
          "value": "test1234",
          "temporary": false
        }
      ],
      "realmRoles": ["user"]
    }
  ],
  "accessTokenLifespan": 300
}
